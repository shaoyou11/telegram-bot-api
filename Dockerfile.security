# Preserve the deployed official Bot API binary, UID and entrypoint.
FROM ghcr.io/shaoyou11/telegram-bot-api@sha256:3ef7ad38566ac54cca97d787ff22d293a7ffdc8ce7031791d3e59fa78c5de4d6
USER root
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends --no-remove \
    && /usr/local/bin/telegram-bot-api --version
USER 101:101
